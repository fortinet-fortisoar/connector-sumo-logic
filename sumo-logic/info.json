                {
                    "title": "Query",
                    "type": "text",
                    "name": "query",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "This query should be valid JSON format."
                },
                {
                    "title": "From",
                    "type": "datetime",
                    "name": "from",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Start date and time should be in YYYY-MM-DDTHH:mm:ss format."
